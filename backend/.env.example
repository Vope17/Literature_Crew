OPENAI_API_KEY=
MODEL=openai/gpt-4o-mini
# openai_api (API billing), codex_cli (ChatGPT login), or claude_cli (Claude login).
AI_BACKEND=openai_api
# CLI modes ignore MODEL and OPENAI_API_KEY. Empty uses the CLI default model.
CLI_MODEL=
CLI_TIMEOUT_SECONDS=600
# Multimodal PDF reading: images/page entries per call (1–8), pages per document (1–1000).
PDF_BATCH_PAGES=4
PDF_MAX_PAGES=200
# SQLite history and PDF storage. Relative paths are resolved inside backend/.
HISTORY_DB_PATH=data/history.sqlite3
# Optional: dedicated credentials for the fallback search provider.
SEMANTIC_SCHOLAR_API_KEY=
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
