upstream literature_backend {
    zone literature_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server app:8000 resolve;
    keepalive 16;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;

    # Only the pages listed in LITERATURE_FRAME_ANCESTORS (the iLearn portal) may show this app in a frame.
    # The nginx image fills the variable in at startup; an empty list forbids framing.
    add_header Content-Security-Policy "frame-ancestors ${LITERATURE_FRAME_ANCESTORS}" always;

    location = /healthz {
        access_log off;
        return 204;
    }

    location / {
        proxy_pass http://literature_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        # Allow AI keyword extraction followed by bounded search provider retries.
        proxy_read_timeout 300s;
        proxy_send_timeout 30s;
    }
}
